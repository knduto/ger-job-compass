# Smart-DE-Reise environment variables. Copy to .env and fill in.
# Never commit real values. All values below are placeholders.

# --- Browser (bundled into the client; publishable values only) ---
VITE_SUPABASE_URL=https://your-backend-project.example
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# --- Server (read inside server functions/routes) ---
SUPABASE_URL=https://your-backend-project.example
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_PROJECT_ID=your-project-id

# Server-only secret. Managed by Lovable Cloud in hosted deployments and not
# retrievable there; only needed locally if you run server-side sync yourself
# against a backend whose service key you control.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for the daily-sync endpoint (must match vault 'daily_sync_token').
LOVABLE_CRON_SECRET=your-cron-secret
# Optional: previous secret accepted during rotation.
LOVABLE_CRON_SECRET_PREVIOUS=

# Optional: database URL used only by drizzle-kit (drizzle.config.ts).
LOVABLE_DB_MIGRATION_URL=
